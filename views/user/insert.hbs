<h2 class="text-center">Tôi thêm khóa học</h2>
<form class="form-course" id="form-insert-course" method="POST" action="/user/insert">
    <div class="form-group">
        <label class="form-label" for="">Tên khóa học</label><br />
        <input class="form-control" type="text" name="name" />
    </div>
    <div class="form-group">
        <label class="form-label" for="">Slug</label><br />
        <input class="form-control" type="text" name="slug" />
    </div>
    <div class="form-group">
        <label class="form-label" for="">VideoId</label><br />
        <input class="form-control" type="text" name="videoId" value="LnTPJcUQdNU"/>
    </div>
    <div class="form-group">
        <label class="form-label" for="">Đường dẫn hình ảnh</label><br />
        <input class="form-control" type="text" name="thumb" value="https://files.fullstack.edu.vn/f8-prod/courses/6.png"/>
    </div>
    <div class="form-group">
        <label class="form-label" for="">Miêu tả</label><br />
        <textarea class="form-control" name="description" rows="6">Không có miêu tả</textarea>
    </div>
    <input
        class="btn btn-outline-success"
        type="submit"
        value="Thêm khóa học"
    />
</form>

<div class="courses-container">
    <div class="row">

    </div>
</div>
