</div> --}}
<div class="courses-container">
    <div class="row">
        {{#each listCourses}}
            <div class="col-md-4 course-wrapper" data-id="{{this.id}}">
                <div class="card mb-5 position-relative">
                    <a href="/courses/{{encodeURIComponent this.slug}}">
                        <img src="{{this.thumb}}" class="card-img-top" alt="..." />
                    </a>
                    <div class="card-body">
                        <a href="/courses/{{encodeURIComponent this.slug}}">
                            <h5 class="card-title">{{this.name}}</h5>
                        </a>
                        <p class="card-text">{{this.description}}</p>
                        <a
                            href="/courses/{{encodeURIComponent this.slug}}"
                            class="btn btn-primary"
                        >Vào xem</a>
                    </div>
                    <span class="position-absolute top-0 start-0 text-light ms-1">#
                        {{@index}} - {{this.accountId}}</span>
                </div>
            </div>
        {{/each}}
    </div>
</div>