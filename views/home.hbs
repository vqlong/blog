<ul class="list-group my-3" id="list-courses"></ul>
<div class="test-handlebars border border-success rounded-2 p-2 mb-3">
    <h3>{{#with firstCourse}}Id is <i>{{id}}</i> and name is <i>{{name}}</i>{{/with}}</h3>
    <div>
        {{#if isShow}}
            <h3>{{showValue}}</h3>
        {{/if}}
    </div>

</div>
