<h2 class="text-center">Tôi đăng ký</h2>
<form class="form-course" method="POST" action="/register">
    <div class="form-group">
        <label class="form-label" for="">Tên đăng nhập</label><br />
        <input class="form-control" type="text" name="username" value="vqlong"/>
    </div>
    <div class="form-group">
        <label class="form-label" for="">Mật khẩu</label><br />
        <input class="form-control" type="password" name="password" value="123456"/>
    </div>
    <div class="form-group">
        <label class="form-label" for="">Xác nhận mật khẩu</label><br />
        <input class="form-control" type="password" value="123456"/>
    </div>
    <input
        class="btn btn-outline-success"
        type="submit"
        value="Đăng ký"
    />
</form>
<b class="text-danger">{{message}}</b>

